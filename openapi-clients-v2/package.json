{
  "name": "openapi-clients-v2",
  "version": "1.0.0",
  "description": "Typed HTTP clients generated from the OpenAPI specs in openapi-specs.",
  "license": "EUPL-1.2",
  "private": false,
  "exports": {
    "./*": "./dist/*/index.js",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/*/index.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "pnpm run generate && rimraf dist && tsdown",
    "build:watch": "pnpm run generate && tsdown --watch",
    "dev": "pnpm run build:watch",
    "generate": "tsx scripts/generateClient.ts all",
    "generate:forms": "tsx scripts/generateClient.ts forms",
    "generate:tax": "tsx scripts/generateClient.ts tax",
    "generate:city-account": "tsx scripts/generateClient.ts city-account",
    "generate:clamav-scanner": "tsx scripts/generateClient.ts clamav-scanner",
    "generate:slovensko-sk": "tsx scripts/generateClient.ts slovensko-sk",
    "generate:magproxy": "tsx scripts/generateClient.ts magproxy",
    "generate-and-build": "pnpm run generate && pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "catalog:"
  },
  "peerDependencies": {
    "axios": "catalog:"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "2.40.1",
    "@types/node": "catalog:",
    "camelcase": "9.0.0",
    "commander": "15.0.0",
    "openapi-specs": "workspace:*",
    "rimraf": "6.1.3",
    "tsdown": "0.22.14",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  },
  "volta": {
    "extends": "../package.json"
  }
}

ARG NODE_VERSION
ARG TURBO_VERSION
FROM node:${NODE_VERSION}-slim AS base

ENV TURBO_TELEMETRY_DISABLED=1
ENV PNPM_HOME=/pnpm
ENV PATH="/opt/pnpm:$PNPM_HOME/bin:$PATH"

WORKDIR /app

COPY --from=pnpm-dist /opt/pnpm /opt/pnpm

FROM base AS prepare
COPY . .
ARG TURBO_VERSION
RUN pnpm dlx turbo@${TURBO_VERSION} prune forms-shared --docker

# Each download has its own stage so it stays cached independently of the
# layers below, and is verified against a pinned SHA-256.
FROM node:${NODE_VERSION}-alpine AS downloader
WORKDIR /download

# Install Apache FOP 1.1. The official URL
# https://archive.apache.org/dist/xmlgraphics/fop/binaries/fop-1.1-bin.zip
# serves it at a couple hundred KB/s at best, which slows the build down
# significantly, so it is fetched from the Huawei Cloud Apache mirror instead.
FROM downloader AS fop
RUN wget -O fop.zip https://mirrors.huaweicloud.com/apache/xmlgraphics/fop/binaries/fop-1.1-bin.zip \
    && echo "eb6e36fab057db1e4302e21998f9cfa0edecda6cbc8d6048285a02e933c1f58a  fop.zip" | sha256sum -c - \
    && unzip -q fop.zip -d /opt \
    && rm fop.zip

# Install Saxon.
FROM downloader AS saxon
RUN wget -O saxon.zip https://github.com/Saxonica/Saxon-HE/raw/f49da493df35079a04b11f5befeae0920ee30263/12/Java/SaxonHE12-5J.zip \
    && echo "35a46728792bd4cec2fc262d48777b4c79b5cdeef03d2981e3a64ecb3a19f716  saxon.zip" | sha256sum -c - \
    && unzip -q saxon.zip -d /opt/saxon \
    && rm saxon.zip

# Download fop.zip from slovensko.sk.
FROM downloader AS slovensko-fop
RUN wget -O fop.zip https://www.slovensko.sk/_img/CMS4/fop.zip \
    && echo "10c1520141b00f97aaa8e52b6de4e6fa135ab013e94d3a6da626b669f140e7f2  fop.zip" | sha256sum -c - \
    && unzip -q fop.zip -d /opt/slovensko-fop \
    && rm fop.zip

FROM base AS test-deps
# Java and XML tooling for the FOP/Saxon pipeline. python3 and build-essential are
# required only on ARM, so native Node modules can compile during the
# `pnpm install` below.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    default-jre-headless \
    libxml2 \
    libxslt1.1 \
    python3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=fop /opt/fop-1.1 /opt/fop-1.1
ENV FOP_JAR=/opt/fop-1.1/build/fop.jar
ENV FOP_LIB=/opt/fop-1.1/lib

COPY --from=saxon /opt/saxon /opt/saxon
ENV SAXON_JAR=/opt/saxon/saxon-he-12.5.jar

COPY --from=slovensko-fop /opt/slovensko-fop /opt/slovensko-fop
ENV SLOVENSKO_FOP_CONF=/opt/slovensko-fop/fop.xconf

# Install Playwright browsers before package files are copied so this layer only
# changes when the Playwright version in the pnpm catalog changes. Chromium and
# its system dependencies are large, so keeping them in a reusable cached layer
# avoids pulling them again after ordinary package or source changes.
ARG PLAYWRIGHT_VERSION
RUN test -n "${PLAYWRIGHT_VERSION}" \
    && pnpm dlx "playwright@${PLAYWRIGHT_VERSION}" install chromium --with-deps

COPY --from=prepare /app/out/json/ .
RUN pnpm install --frozen-lockfile

COPY --from=prepare /app/out/full/ .

WORKDIR /app/forms-shared

FROM test-deps AS test-local
CMD [ "pnpm", "run", "test:ci" ]

FROM test-deps AS test-local-update
CMD [ "pnpm", "run", "test:ci:update" ]

# CI runs tests inside `docker build` so the target can be cached.
FROM test-deps AS test
RUN pnpm run test:ci

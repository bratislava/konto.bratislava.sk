{
  "name": "@bratislava/email-templates",
  "version": "1.0.0",
  "description": "Emails of Bratislavské konto and related city services, rendered with React Email.",
  "license": "EUPL-1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit --project tsconfig.build.json && tsdown && node scripts/verify-dist.ts",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:update": "playwright test --update-snapshots",
    "test:ci": "cross-env CI=true playwright test",
    "test:ci:update": "cross-env CI=true playwright test --update-snapshots",
    "docker:test": "node scripts/run-docker-test.ts test-local",
    "docker:test:update": "node scripts/run-docker-test.ts test-local-update",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check ."
  },
  "exports": {
    "./forms/summary-email": {
      "types": "./dist/forms/summary-email.d.ts",
      "default": "./dist/forms/summary-email.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "forms/summary-email": [
        "dist/forms/summary-email.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "sideEffects": false,
  "dependencies": {
    "classnames": "2.5.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-email": "6.11.3"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "cross-env": "10.1.0",
    "forms-shared": "workspace:*",
    "prettier": "3.9.10",
    "tsdown": "0.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "forms-shared": "workspace:*"
  },
  "peerDependenciesMeta": {
    "forms-shared": {
      "optional": true
    }
  },
  "volta": {
    "extends": "../package.json"
  }
}

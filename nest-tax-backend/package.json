{
  "name": "nest-tax-backend",
  "version": "0.0.5",
  "description": "Backend service for tax handling",
  "author": "Department of Innovation and Technology - City of Bratislava",
  "private": false,
  "license": "EUPL-1.2",
  "scripts": {
    "build": "nest build",
    "build:dependencies": "pnpm -w exec turbo run build --filter=nest-tax-backend... --filter=!nest-tax-backend",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "verify-bootstrap": "cross-env NEST_PREVIEW=true node --env-file=.env.example dist/main",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,apps,libs,test}/**/*.{ts,js}\"",
    "lint:report": "eslint -f json -o eslint-report.json \"{src,apps,libs,test}/**/*.{ts,js}\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.{ts,js}\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "db:generate": "cross-env PRISMA_SKIP_DATASOURCE_URL=1 prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "vulnerabilities": "pnpm audit --audit-level=high --registry=https://registry.npmjs.org"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1158.0",
    "@bratislava/log-nest": "2.2.0",
    "@nestjs-cognito/auth": "2.6.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "12.0.5",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "axios": "catalog:",
    "bysquare": "2.13.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "cross-env": "10.1.0",
    "csv-parse": "7.0.3",
    "currency.js": "2.0.4",
    "dayjs": "1.11.23",
    "express": "5.3.0",
    "form-urlencoded": "6.1.8",
    "lodash": "4.18.1",
    "mssql": "12.7.13",
    "nodemailer": "8.0.11",
    "openapi-clients": "workspace:*",
    "p-limit": "3.1.0",
    "passport-headerapikey": "1.2.2",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "qrcode": "1.5.4",
    "ssh2-sftp-client": "12.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@bratislava/eslint-config-nest": "0.21.0",
    "@golevelup/ts-vitest": "4.0.1",
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@types/express": "5.0.6",
    "@types/lodash": "4.17.27",
    "@types/mssql": "12.3.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "1.5.6",
    "@types/ssh2-sftp-client": "9.0.6",
    "@typescript-eslint/parser": "8.72.1",
    "@vitest/coverage-v8": "5.0.5",
    "clear": "0.1.0",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "path": "0.12.7",
    "prettier": "3.9.10",
    "prisma-json-types-generator": "5.2.0",
    "source-map-support": "0.5.21",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vitest-mock-extended": "5.1.1"
  },
  "volta": {
    "extends": "../package.json"
  }
}

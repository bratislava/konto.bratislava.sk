{
  "name": "nest-clamav-scanner",
  "version": "0.0.2",
  "description": "NestJS ClamAV Scanner using ClamAV.js for scanning files and streams.",
  "author": "Department of Innovation and Technology of the City of Bratislava",
  "private": false,
  "license": "LICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "build:dependencies": "pnpm -w exec turbo run build --filter=nest-clamav-scanner... --filter=!nest-clamav-scanner",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,apps,libs,test}/**/*.{ts,js}\"",
    "lint:report": "eslint -f json -o eslint-report.json \"{src,apps,libs,test}/**/*.{ts,js}\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.{ts,js}\" --fix",
    "run-esm-jest": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test": "pnpm run-esm-jest",
    "test:watch": "pnpm run-esm-jest --watch",
    "test:cov": "pnpm run-esm-jest --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules --disable-warning=ExperimentalWarning -r tsconfig-paths/register -r ts-node/register node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "pnpm run-esm-jest --config ./test/jest-e2e.json",
    "db:generate": "cross-env PRISMA_SKIP_DATASOURCE_URL=1 prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "vulnerabilities": "pnpm audit --audit-level=high --registry=https://registry.npmjs.org"
  },
  "dependencies": {
    "@nestjs/common": "12.1.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.0",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "await-exec": "0.1.2",
    "axios": "catalog:",
    "base64url": "3.0.1",
    "clamdjs": "1.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "express": "5.2.1",
    "mime-types": "3.0.2",
    "minio": "8.0.7",
    "openapi-clients": "workspace:*",
    "passport-http": "0.3.0",
    "pg": "8.22.0",
    "prisma": "7.9.0"
  },
  "devDependencies": {
    "@bratislava/eslint-config-nest": "0.19.1",
    "@nestjs/cli": "12.0.6",
    "@nestjs/schematics": "12.0.5",
    "@nestjs/testing": "12.1.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/mime-types": "3.0.1",
    "@types/node": "catalog:",
    "@types/passport-http": "0.3.11",
    "cross-env": "10.1.0",
    "dotenv": "17.4.2",
    "eslint": "9.39.4",
    "jest": "30.5.2",
    "path": "0.12.7",
    "prettier": "3.6.2",
    "rimraf": "6.0.1",
    "source-map-support": "0.5.21",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/",
      "/openapi-clients/dist/"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "volta": {
    "extends": "../package.json"
  }
}

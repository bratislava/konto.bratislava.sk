{
  "name": "repository-scripts",
  "version": "1.0.0",
  "description": "Repository-wide maintenance scripts: toolchain and dependency version checks, and the Docker build args CI reads from the pinned versions.",
  "license": "EUPL-1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "print-docker-build-args": "node print-docker-build-args.ts",
    "verify-exact-package-versions": "node verify-exact-package-versions.ts",
    "verify-toolchain-versions": "node verify-toolchain-versions.ts"
  },
  "dependencies": {
    "semver": "7.8.5",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.4",
    "@types/node": "catalog:",
    "@types/semver": "7.7.1",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.17.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.17.0",
      "onFail": "error"
    }
  },
  "volta": {
    "extends": "../package.json"
  }
}

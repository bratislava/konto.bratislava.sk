ARG NODE_VERSION
ARG TURBO_VERSION
FROM node:${NODE_VERSION}-slim AS base

ENV TURBO_TELEMETRY_DISABLED=1
ENV PNPM_HOME=/pnpm
ENV PATH="/opt/pnpm:$PNPM_HOME/bin:$PATH"

WORKDIR /app

COPY --from=pnpm-dist /opt/pnpm /opt/pnpm

FROM base AS prepare
COPY . .
ARG TURBO_VERSION
RUN pnpm dlx turbo@${TURBO_VERSION} prune @bratislava/email-templates --docker

FROM base AS test-deps
# python3 and build-essential are required only on ARM, so native Node modules can compile during
# the `pnpm install` below.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3 \
    && rm -rf /var/lib/apt/lists/*

# Install the browsers before the package files are copied, so this large layer only changes when
# the Playwright version in the pnpm catalog changes. WebKit renders like Apple Mail, Chromium like
# webmail in Chrome.
ARG PLAYWRIGHT_VERSION
RUN test -n "${PLAYWRIGHT_VERSION}" \
    && pnpm dlx "playwright@${PLAYWRIGHT_VERSION}" install chromium webkit --with-deps

COPY --from=prepare /app/out/json/ .
RUN pnpm install --frozen-lockfile

COPY --from=prepare /app/out/full/ .

# The form emails import forms-shared's build.
RUN pnpm --filter "@bratislava/email-templates^..." run build

WORKDIR /app/email-templates

# Screenshots only match pixel for pixel in this image, so the screenshot projects exist only here.
ENV EMAIL_TEMPLATES_SCREENSHOTS=1

FROM test-deps AS test-local
CMD [ "pnpm", "run", "test:ci" ]

FROM test-deps AS test-local-update
CMD [ "pnpm", "run", "test:ci:update" ]

# CI runs tests inside `docker build` so the target can be cached.
FROM test-deps AS test
RUN pnpm run test:ci

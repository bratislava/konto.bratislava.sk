// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

generator json {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider = "postgresql"
}

enum CognitoUserAttributesTierEnum {
  NEW
  QUEUE_IDENTITY_CARD
  NOT_VERIFIED_IDENTITY_CARD
  IDENTITY_CARD
  EID
}

enum DeliveryMethodEnum {
  EDESK
  CITY_ACCOUNT
  POSTAL
}

// Edesk is stored in PhysicalEntity and we do not want to duplicate it in User
enum DeliveryMethodUserPreferenceEnum {
  CITY_ACCOUNT
  POSTAL
}

enum ConsentEnum {
  MARKETING
  GENERAL
}

enum GDPRTypeEnum {
  ANALYTICS
  DATAPROCESSING
  FORMAL_COMMUNICATION
  GENERAL
  MARKETING
}

enum GDPRSubTypeEnum {
  subscribe
  unsubscribe
}

enum GDPRCategoryEnum {
  CITY
  ESBS
  SWIMMINGPOOLS
  TAXES
  INIT
  LIBRARY
}

enum LoginClientEnum {
  DPB
  PAAS_MPA
  TICKETS
  CITY_ACCOUNT
}

enum QueueItemStatusEnum {
  PENDING
  NEW_URI_CHECK_REQUIRED
  COMPLETED
  FAILED
}

enum BloomreachOutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SUPERSEDED
}

enum BloomreachCommandName {
  CUSTOMERS        @map("customers")
  CUSTOMERS_EVENTS @map("customers/events")
}

model User {
  id                                   String                            @id @default(uuid()) @db.Uuid
  createdAt                            DateTime                          @default(now())
  updatedAt                            DateTime                          @updatedAt
  registeredAt                         DateTime?
  externalId                           String                            @unique
  email                                String?                           @unique
  ifo                                  String?                           @unique
  birthNumber                          String?                           @unique // If set, lastVerificationIdentityCard must also be set; enforced by a hidden DB CHECK constraint not represented here.
  lastVerificationIdentityCard         DateTime?
  oldMagproxyDatabase                  Int                               @default(0)
  requeuedInVerification               Int                               @default(0)
  birthnumberAlreadyExistsLast         String?
  birthnumberAlreadyExistsCounter      Int                               @default(0)
  userAttribute                        String?
  userGdprData                         UserGdprData[]
  physicalEntity                       PhysicalEntity?
  lastTaxDeliveryMethodsUpdateYear     Int?
  taxDeliveryMethod                    DeliveryMethodUserPreferenceEnum? // User's current delivery method preference for tax documents; changes are mirrored into DeliveryMethodPreferenceHistory by a trigger.
  taxDeliveryMethodAtLockDate          DeliveryMethodEnum? // Delivery method locked at tax season start (February 1st) - used for actual delivery; if CITY_ACCOUNT, taxDeliveryMethodCityAccountLockDate must be set (hidden DB CHECK constraint not represented here).
  taxDeliveryMethodCityAccountLockDate DateTime? // Date when CITY_ACCOUNT delivery method was selected by user before lock date
  // This is used to store the last time we tried to update the delivery methods in Noris for this user.
  lastTaxDeliveryMethodsUpdateTry      DateTime                          @default(now())
  cognitoTier                          CognitoUserAttributesTierEnum?
  userIdCardVerify                     UserIdCardVerify[]
  userLoginClients                     UserLoginClient[]
  isDeceased                           Boolean                           @default(false)
  markedDeceasedAt                     DateTime?
  deliveryMethodUserHistory            DeliveryMethodPreferenceHistory[]
  userConsents                         UserConsents[]
  userConsentsHistory                  UserConsentsHistory[]
}

/**
 * Current consent state per (user, consentType).
 * App writes here; trigger maintains UserConsentsHistory.
 */
model UserConsents {
  id          String      @id @default(uuid()) @db.Uuid
  createdAt   DateTime    @default(now())
  userId      String      @db.Uuid
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentType ConsentEnum
  isGranted   Boolean

  @@unique([userId, consentType])
}

/**
 * Append-only audit log of UserConsents changes.
 * Immutability enforced by trigger.
 */
model UserConsentsHistory {
  id          String      @id @default(uuid()) @db.Uuid
  createdAt   DateTime    @default(now())
  userId      String      @db.Uuid
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentType ConsentEnum
  isGranted   Boolean

  @@index([userId])
}

// In this table we store for one month the data used by a user to verify their account by ID card.
// Encrypted columns - idCard, birthNumber, givenName, familyName. Encryption and decryption is described in src/utils/crypto.ts.
// givenName and familyName of rows created before they were added hold the unencrypted placeholder 'not-set'.
// The reason behind it is that when there is a failure during verification, we need to get these values fast to check manually.
model UserIdCardVerify {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id])
  birthNumber String
  idCard      String
  givenName   String
  familyName  String
  verifyStart DateTime @default(now())
}

// consolidates data from magproxy / NASES
// a physicalEntity record may or may not be linked to exactly one User record, and vice versa
// Statutory representatives (konatelia) of a LegalPerson are stored here too, usually without a User.
model PhysicalEntity {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User?   @relation(fields: [userId], references: [id])
  userId      String? @unique @db.Uuid
  uri         String? @unique
  ifo         String? @unique
  birthNumber String?

  // UPVS identity of the person, from SAML `Actor.UPVSIdentityID` (eID login). Stable across URI changes.
  upvsIdentityId String? @unique @db.Uuid
  // Formatted name of the eID actor, from SAML `Actor.FormattedName`.
  upvsName       String?

  uriPossiblyOutdated Boolean @default(false)

  activeEdesk                Boolean? // Changing this value updates edeskStatusChangedAt via a trigger.
  edeskStatusChangedAt       DateTime? // Do not update, managed by database.
  activeEdeskUpdatedAt       DateTime?
  activeEdeskUpdateFailedAt  DateTime?
  activeEdeskUpdateFailCount Int       @default(0)

  identityLookupRejection IdentityLookupRejection?

  legalPersonRepresentations LegalPersonRepresentation[]
  legalPersonAccounts        LegalPersonAccount[]
}

model IdentityLookupRejection {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  physicalEntity   PhysicalEntity @relation(fields: [physicalEntityId], references: [id], onDelete: Cascade)
  physicalEntityId String         @unique @db.Uuid

  // Fault details from the slovensko-sk container.
  faultCode   String?
  faultReason String?
}

model ExternalEdeskCheck {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  uri         String?             @unique
  newUri      String?
  queueStatus QueueItemStatusEnum @default(PENDING)

  upvsStatus     String?
  edeskStatus    String?
  edeskNumber    String?
  edeskDeathDate String?

  norisId Int @unique

  processedAt DateTime?
  failCount   Int       @default(0)

  @@index([queueStatus])
  @@index([createdAt])
}

enum LegalPersonKindEnum {
  PO // pravnicka osoba
  FO_P // fyzicka osoba - podnikatel (self-employed); the representative is the owner themselves
  DEPARTMENT // magistrát department pseudo-company (employee accounts), see docs/runbook/vytvorenie-konta-pre-zamestnancov.md
}

enum LegalPersonRepresentationTypeEnum {
  STATUTORY_BODY // konateľ / štatutárny orgán of a PO
  OWNER // the FO-P person themselves
}

/**
 * A company (PO), self-employed person (FO-P), or magistrát department, identified by IČO.
 * Cognito logins of the company are LegalPersonAccount rows.
 * Consistency enforced by hidden DB constraints and triggers (not represented here):
 * - DEPARTMENT: `upvsIdentityId` IS NULL, `ico` is not numeric (so it can never match a real IČO),
 * and it has no LegalPersonRepresentation rows.
 * - PO / FO_P: `ico` is numeric (optionally with a `_suffix` of an UPVS organisational unit).
 * - Representation type must match the kind: PO -> STATUTORY_BODY, FO_P -> OWNER.
 * - `kind` cannot change while representations exist.
 */
model LegalPerson {
  id             String              @id @default(uuid()) @db.Uuid
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  kind           LegalPersonKindEnum
  ico            String              @unique
  // UPVS identity of the company, from SAML `Subject.UPVSIdentityID`. NULL for departments and
  // for companies migrated from before this was recorded, until their next eID verification.
  upvsIdentityId String?             @unique @db.Uuid

  representations LegalPersonRepresentation[]
  accounts        LegalPersonAccount[]
}

/**
 * N:N between a PhysicalEntity (konateľ / FO-P owner) and the LegalPerson they represent.
 * `validTo` IS NULL means the representation is currently valid.
 */
model LegalPersonRepresentation {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  physicalEntityId String         @db.Uuid
  physicalEntity   PhysicalEntity @relation(fields: [physicalEntityId], references: [id], onDelete: Restrict)
  legalPersonId    String         @db.Uuid
  legalPerson      LegalPerson    @relation(fields: [legalPersonId], references: [id], onDelete: Restrict)

  type           LegalPersonRepresentationTypeEnum
  validFrom      DateTime                          @default(now())
  validTo        DateTime? // CHECK validTo >= validFrom (hidden DB constraint)
  lastVerifiedAt DateTime                          @default(now())

  accounts LegalPersonAccount[]

  @@unique([physicalEntityId, legalPersonId])
  @@index([legalPersonId])
}

/**
 * Cognito login of a legal-person account type (`po`, `fo-p`). Before #1801 this table was `LegalPerson`.
 * `legalPersonId` is set once the account is verified (or set up as a department account).
 * `physicalEntityId` is the representative who verified it; it is NULL for department accounts.
 * Hidden DB constraints (not represented here):
 * - (`legalPersonId`, `ico`) references LegalPerson (`id`, `ico`), so the legacy `ico` column
 * always equals the company's IČO; `ico` and `legalPersonId` are both set or both NULL.
 * - (`physicalEntityId`, `legalPersonId`) references LegalPersonRepresentation, so the verifying
 * person actually represents the company.
 */
model LegalPersonAccount {
  id                                 String                         @id @default(uuid()) @db.Uuid
  createdAt                          DateTime                       @default(now())
  updatedAt                          DateTime                       @updatedAt
  registeredAt                       DateTime?
  externalId                         String                         @unique
  email                              String?                        @unique
  lastVerificationAttempt            DateTime?
  birthnumberIcoAlreadyExistsLast    String?
  birthnumberIcoAlreadyExistsCounter Int                            @default(0)
  userAttribute                      String?
  legalPersonGdprData                LegalPersonGdprData[]
  cognitoTier                        CognitoUserAttributesTierEnum?
  legalPersonLoginClients            LegalPersonLoginClient[]
  legalPersonConsents                LegalPersonConsents[]
  legalPersonConsentsHistory         LegalPersonConsentsHistory[]

  legalPersonId    String?                    @db.Uuid
  legalPerson      LegalPerson?               @relation(fields: [legalPersonId], references: [id], onDelete: Restrict)
  physicalEntityId String?                    @db.Uuid
  physicalEntity   PhysicalEntity?            @relation(fields: [physicalEntityId], references: [id], onDelete: Restrict)
  representation   LegalPersonRepresentation? @relation(fields: [physicalEntityId, legalPersonId], references: [physicalEntityId, legalPersonId], onDelete: Restrict)

  // One account per (company, representative); department accounts (no representative) are not limited.
  @@unique([legalPersonId, physicalEntityId])
  @@index([physicalEntityId])
}

/**
 * Current consent state per (legalPersonAccount, consentType).
 * App writes here; trigger maintains LegalPersonConsentsHistory.
 */
model LegalPersonConsents {
  id                   String             @id @default(uuid()) @db.Uuid
  createdAt            DateTime           @default(now())
  legalPersonAccountId String             @db.Uuid
  legalPersonAccount   LegalPersonAccount @relation(fields: [legalPersonAccountId], references: [id], onDelete: Cascade)
  consentType          ConsentEnum
  isGranted            Boolean

  @@unique([legalPersonAccountId, consentType])
}

/**
 * Append-only audit log of LegalPersonConsents changes.
 * Immutability enforced by trigger.
 */
model LegalPersonConsentsHistory {
  id                   String             @id @default(uuid()) @db.Uuid
  createdAt            DateTime           @default(now())
  legalPersonAccountId String             @db.Uuid
  legalPersonAccount   LegalPersonAccount @relation(fields: [legalPersonAccountId], references: [id], onDelete: Cascade)
  consentType          ConsentEnum
  isGranted            Boolean

  @@index([legalPersonAccountId])
}

/**
 * Table containing all the historical changes to user delivery method preference.
 * **This table is managed by database** and any edits from the app user will
 * result in an error
 */
model DeliveryMethodPreferenceHistory {
  id        String                           @id @default(uuid()) @db.Uuid
  createdAt DateTime                         @default(now())
  userId    String                           @db.Uuid
  user      User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  method    DeliveryMethodUserPreferenceEnum

  @@unique([userId, createdAt])
  @@index([userId])
}

model UserGdprData {
  id        String           @id @default(uuid())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  userId    String           @db.Uuid
  type      GDPRTypeEnum
  category  GDPRCategoryEnum
  subType   GDPRSubTypeEnum?
  user      User             @relation(fields: [userId], references: [id])
}

model LegalPersonGdprData {
  id                   String             @id @default(uuid())
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  legalPersonAccountId String             @db.Uuid
  type                 GDPRTypeEnum
  category             GDPRCategoryEnum
  subType              GDPRSubTypeEnum?
  legalPersonAccount   LegalPersonAccount @relation(fields: [legalPersonAccountId], references: [id])
}

model UserLoginClient {
  id          String          @id @default(uuid()) @db.Uuid
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  userId      String          @db.Uuid
  loginClient LoginClientEnum
  loginCount  Int             @default(0)
  user        User            @relation(fields: [userId], references: [id])

  @@unique([userId, loginClient])
  @@index([userId])
  @@index([loginClient])
}

model LegalPersonLoginClient {
  id                   String             @id @default(uuid()) @db.Uuid
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  legalPersonAccountId String             @db.Uuid
  loginClient          LoginClientEnum
  loginCount           Int                @default(0)
  legalPersonAccount   LegalPersonAccount @relation(fields: [legalPersonAccountId], references: [id])

  @@unique([legalPersonAccountId, loginClient])
  @@index([legalPersonAccountId])
}

model Config {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  key       String   @unique
  value     Json
}

model OAuth2Data {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Authorization request parameters
  responseType        String // 'code' for Authorization Code flow
  clientId            String
  redirectUri         String
  scope               String? // Space-delimited list of scopes
  state               String? // CSRF protection token
  // PKCE is mandatory for every client, so both are always present.
  codeChallenge       String // PKCE code challenge
  codeChallengeMethod String // PKCE code challenge method: 'S256' or 'plain'

  // Grant generated during authorization
  authorizationCode          String?   @unique
  authorizationCodeCreatedAt DateTime?

  // Encrypted (and base64-encoded) token values
  accessTokenEnc       String?
  accessTokenExpiresAt DateTime?
  idTokenEnc           String?
  refreshTokenEnc      String?
}

model BloomreachOutbox {
  id          String                 @id @default(uuid()) @db.Uuid
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  externalId  String
  commandName BloomreachCommandName
  /// [BloomreachCommandData]
  commandData Json
  status      BloomreachOutboxStatus @default(PENDING)
  attempts    Int                    @default(0)
  lastError   String?
  /// Marks the authoritative entry for a deduplication key (the
  /// two unique indexes below)
  /// - Rejects any later non-terminal write to the same dedup key.
  /// - Triggers deletion of every other entry for the same dedup key.
  isTerminal  Boolean                @default(false)

  // Equivalent exists in the database but Prisma does not support JSON-path index columns:
  // @@unique([externalId, eventType, category], map: "bloomreach_outbox_events_pending_key",
  //          where: raw('"commandName" = 'customers/events'
  //                         AND "status" = 'PENDING'
  //                         AND "commandData" ->> 'event_type' IS NOT NULL
  //                         AND "commandData" -> 'properties' ->> 'category' IS NOT NULL"))
  @@unique([externalId], map: "bloomreach_outbox_customers_pending_key", where: { commandName: "customers", status: "PENDING" })
  @@index([status, createdAt])
  @@index([externalId, commandName, status])
}

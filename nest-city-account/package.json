{
  "name": "nest-city-account",
  "version": "0.0.2",
  "description": "City account project.",
  "author": "Bratislava city inovation",
  "private": false,
  "scripts": {
    "build": "nest build",
    "build:dependencies": "pnpm -w exec turbo run build --filter=nest-city-account... --filter=!nest-city-account",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:repl": "nest start --watch --entryFile repl",
    "start:prod": "node dist/main",
    "verify-bootstrap": "cross-env NEST_PREVIEW=true node --env-file=.env.example dist/main",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,js}\" \"test/**/*.{ts,js}\"",
    "lint:report": "eslint -f json -o eslint-report.json \"src/**/*.{ts,js}\" \"test/**/*.{ts,js}\"",
    "lint:fix": "eslint \"src/**/*.{ts,js}\" \"test/**/*.{ts,js}\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "db:generate": "cross-env PRISMA_SKIP_DATASOURCE_URL=1 prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "vulnerabilities": "pnpm audit --audit-level=high --registry=https://registry.npmjs.org"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1159.0",
    "@bratislava/log-nest": "2.2.0",
    "@golevelup/nestjs-rabbitmq": "9.1.1",
    "@keyv/redis": "5.1.6",
    "@nestjs/cache-manager": "12.0.2",
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "12.0.5",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "amqplib": "2.2.0",
    "axios": "catalog:",
    "cache-manager": "7.2.9",
    "cf-turnstile": "1.0.8",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cross-env": "10.1.0",
    "dayjs": "1.11.23",
    "express": "5.3.0",
    "form-data": "4.0.6",
    "jsonwebtoken": "9.0.3",
    "jwks-rsa": "4.1.0",
    "lodash": "4.18.1",
    "luxon": "3.7.2",
    "mailgun.js": "14.1.0",
    "mssql": "12.7.13",
    "openapi-clients": "workspace:*",
    "p-limit": "7.3.3",
    "passport-custom": "1.2.1",
    "passport-headerapikey": "1.2.2",
    "passport-jwt": "4.0.1",
    "pg": "8.23.1",
    "pg-promise": "12.7.1",
    "playwright": "catalog:",
    "prisma": "7.10.1",
    "rodnecislo": "1.8.0",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@bratislava/eslint-config-nest": "0.21.0",
    "@golevelup/ts-vitest": "4.0.1",
    "@nestjs/cli": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/lodash": "4.17.27",
    "@types/luxon": "3.7.6",
    "@types/mssql": "12.3.0",
    "@types/node": "catalog:",
    "@types/passport-jwt": "4.0.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitest/coverage-v8": "5.0.5",
    "dotenv": "18.0.9",
    "eslint": "9.39.5",
    "npm-run-all": "4.1.5",
    "prettier": "3.9.10",
    "prisma-json-types-generator": "5.2.0",
    "ts-unused-exports": "11.0.1",
    "type-fest": "5.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vitest-mock-extended": "5.1.1"
  },
  "volta": {
    "extends": "../package.json"
  }
}

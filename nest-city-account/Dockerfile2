# ==========================================
# Stage 1: Build & Generate Types
# ==========================================
FROM node:24.15-alpine AS builder

# Install system dependencies needed for Prisma compilation on Alpine
RUN apk add --no-cache openssl directional-dependencies libc6-compat

WORKDIR /usr/src/app

# Copy lockfiles first to leverage Docker caching layers
COPY package*.json ./
COPY prisma ./prisma/

# Clean install all dependencies (including devDependencies like TypeScript)
RUN npm ci

# Copy the rest of the application code
COPY . .

# Generate Prisma Client (builds types inside node_modules)
RUN npx prisma generate

# Build the NestJS application (transpiles TS to JS inside /dist)
RUN npm run build

# ==========================================
# Stage 2: Prune Production Dependencies
# ==========================================
FROM node:22-alpine AS dependencies

WORKDIR /usr/src/app

COPY package*.json ./
COPY prisma ./prisma/

# Install ONLY production dependencies
RUN npm ci --omit=dev

# Regenerate Prisma Client for the production-only dependencies
RUN npx prisma generate

# ==========================================
# Stage 3: Final Production Image
# ==========================================
FROM node:22-alpine AS runner

# Ensure OpenSSL is available for Prisma engine runtime
RUN apk add --no-cache openssl

WORKDIR /usr/src/app

# Set production environment flags
ENV NODE_ENV=production

# Create and use a secure non-root user
USER node

COPY --from=builder --chown=node:node /usr/src/app/dist ./dist

# Copy pruned node_modules and Prisma runtime artifacts
COPY --from=dependencies --chown=node:node /usr/src/app/node_modules ./node_modules
COPY --from=dependencies --chown=node:node /usr/src/app/prisma ./prisma

# Expose the API port
EXPOSE 3000

# Start the application using node directly
CMD [ "node", "dist/main.js" ]

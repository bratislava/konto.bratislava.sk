{
  "name": "nest-forms-backend",
  "version": "0.0.1",
  "description": "Backend responsible for processing forms for online services.",
  "author": "Department of Innovation and Technology of the City of Bratislava",
  "private": false,
  "license": "LICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "build:dependencies": "pnpm -w exec turbo run build --filter=nest-forms-backend... --filter=!nest-forms-backend",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "verify-bootstrap": "cross-env NEST_PREVIEW=true node --env-file=.env.example dist/main",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,apps,libs,test}/**/*.{ts,js}\"",
    "lint:report": "eslint -f json -o eslint-report.json \"{src,apps,libs,test}/**/*.{ts,js}\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.{ts,js}\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.mts",
    "db:generate": "cross-env PRISMA_SKIP_DATASOURCE_URL=1 prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "vulnerabilities": "pnpm audit --audit-level=high --registry=https://registry.npmjs.org"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity": "3.1095.0",
    "@aws-sdk/client-cognito-identity-provider": "3.1095.0",
    "@aws-sdk/client-sts": "3.1095.0",
    "@bratislava/ginis-sdk": "2.4.0",
    "@bratislava/log-nest": "2.0.0",
    "@golevelup/nestjs-rabbitmq": "9.1.0",
    "@nestjs/bull": "12.0.0",
    "@nestjs/common": "12.1.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.0",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "@rjsf/utils": "catalog:",
    "amqplib": "2.0.1",
    "aws-jwt-verify": "5.2.1",
    "axios": "catalog:",
    "bull": "4.16.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "content-disposition": "1.0.1",
    "cross-env": "10.1.0",
    "express": "5.2.1",
    "form-data": "4.0.6",
    "forms-shared": "workspace:*",
    "handlebars": "4.7.9",
    "jsonwebtoken": "9.0.3",
    "lodash": "4.17.23",
    "mailgun.js": "13.1.0",
    "mime-types": "3.0.2",
    "minio": "8.0.7",
    "multer": "2.2.0",
    "nodemailer": "8.0.7",
    "openapi-clients": "workspace:*",
    "passport-custom": "1.1.1",
    "passport-headerapikey": "1.2.2",
    "passport-http": "0.3.0",
    "passport-http-bearer": "1.0.1",
    "passport-jwt": "4.0.1",
    "pg": "8.22.0",
    "piscina": "5.3.0",
    "playwright": "catalog:",
    "prisma": "7.9.0",
    "reflect-metadata": "0.2.2",
    "uuid": "11.1.0",
    "xml2js": "0.6.2"
  },
  "devDependencies": {
    "@bratislava/eslint-config-nest": "0.19.1",
    "@golevelup/ts-vitest": "4.0.0",
    "@nestjs/cli": "12.0.6",
    "@nestjs/schematics": "12.0.5",
    "@nestjs/testing": "12.1.0",
    "@ngneat/falso": "8.0.2",
    "@testcontainers/postgresql": "11.14.0",
    "@types/amqplib": "0.10.8",
    "@types/content-disposition": "0.5.9",
    "@types/express": "5.0.6",
    "@types/json-schema": "7.0.15",
    "@types/jsonwebtoken": "9.0.10",
    "@types/lodash": "4.17.23",
    "@types/mime-types": "3.0.1",
    "@types/multer": "2.2.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "8.0.0",
    "@types/passport-http": "0.3.11",
    "@types/passport-http-bearer": "1.0.42",
    "@types/passport-jwt": "4.0.1",
    "@types/xml2js": "0.4.14",
    "@typescript-eslint/parser": "8.68.0",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/eslint-plugin": "1.6.27",
    "dotenv": "17.4.2",
    "eslint": "9.39.4",
    "nock": "14.0.16",
    "prettier": "3.8.1",
    "prisma-json-types-generator": "5.1.1",
    "rimraf": "6.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.3.1",
    "vitest": "5.0.3",
    "vitest-mock-extended": "5.1.1"
  },
  "volta": {
    "extends": "../package.json"
  }
}
